# Copy to .env.local for local development. On Vercel, set the same variable in the project settings.
# Public address of the data bucket (not a secret):
VITE_DATA_BASE_URL=https://<project>.supabase.co/storage/v1/object/public/fishing-data

# Fishing records (M4). Both are public values: the project address and the "anon public" key.
# NEVER put the service_role key here or anywhere in web/.
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>
